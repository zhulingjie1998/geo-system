# MySQL
GEO_DB_HOST=127.0.0.1
GEO_DB_PORT=3306
GEO_DB_USER=
GEO_DB_PASSWORD=
GEO_DB_NAME=waimao_geo

# Flask（生成：python3 -c "import secrets;print(secrets.token_hex(32))"）
GEO_FLASK_SECRET=
GEO_EXTERNAL_TOKEN_SECRET=

# 首次启动创建的超管初始密码
GEO_INIT_ADMIN_PW=admin123

# 开发服务器（dev_server.py）
GEO_DEV_HOST=0.0.0.0
GEO_DEV_PORT=3106

# Gunicorn（生产）
GEO_GUNICORN_BIND=127.0.0.1:7106
GEO_GUNICORN_WORKERS=1
GEO_GUNICORN_THREADS=4
GEO_GUNICORN_TIMEOUT=600
GEO_LOG_DIR=./logs

# 查词服务
GEO_SEARCH_API_URL=

# LLM 网关
GEO_LLM_BASE_URL=

# Redis
GEO_REDIS_HOST=127.0.0.1
GEO_REDIS_PORT=6379
GEO_REDIS_DB=0
